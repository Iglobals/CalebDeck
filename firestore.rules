rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isRider() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'RIDER';
    }

    // ─── Menu Items ───
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Mart Items ───
    match /mart_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Combo Packs ───
    match /combo_packs/{comboId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Hostels ───
    match /hostels/{hostelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Orders ───
    // Public read: students track orders by unpredictable document ID
    // Server creates orders (Firebase Admin SDK bypasses rules)
    match /orders/{orderId} {
      allow read: if true;

      allow create: if isAdmin();

      // Admin or assigned rider can update
      allow update: if isAdmin() ||
        (isRider() && resource.data.assignedRiderId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ─── Mart Orders ───
    match /mart_orders/{orderId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isRider() && resource.data.riderId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── Batches ───
    // Riders MUST be able to update their own batches (mark as delivered)
    match /batches/{batchId} {
      allow read: if isAdmin() ||
        (isRider() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isRider() && resource.data.riderId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── Riders ───
    // Public read: students see assigned rider name/phone on tracking page
    match /riders/{riderId} {
      allow read: if true;

      allow update: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == riderId);

      allow create: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == riderId);
      allow delete: if isAdmin();
    }

    // ─── Users (Auth profiles) ───
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == userId);

      // Admin reads all users (for FCM tokens, etc.)
      allow read: if isAdmin();

      allow delete: if isAdmin();
    }

    // ─── Notifications ───
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.userId == 'admin' && isAdmin())
      );

      allow create: if isAuthenticated();

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.userId == 'admin' && isAdmin())
      );

      allow delete: if isAdmin();
    }

    // ─── Rider Stats & Earnings ───
    match /riderStats/{riderId}/weekly/{weekId} {
      allow read: if isAdmin() || (isRider() && request.auth.uid == riderId);
      allow write: if isAdmin() || (isRider() && request.auth.uid == riderId);
    }

    match /riderEarnings/{riderId}/daily/{date} {
      allow read: if isAdmin() || (isRider() && request.auth.uid == riderId);
      allow write: if isAdmin() || (isRider() && request.auth.uid == riderId);
    }

    match /bonus_claims/{claimId} {
      allow read: if isAdmin() || (isRider() && resource.data.riderId == request.auth.uid);
      allow create: if isRider() && request.resource.data.riderId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Rider Payouts ───
    match /rider_payouts/{payoutId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin() || isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── CalebNet ───
    match /calebnet_catalog/{planId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if isAdmin();
    }

    match /calebnet_provider_plans/{planId} {
      allow read, write: if isAdmin();
    }

    match /calebnet_orders/{orderId} {
      allow read: if isAdmin();
      allow create: if false; // Only backend (Admin SDK) creates
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /calebnet_provider_status/{statusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Settings ───
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Reviews ───
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ─── Default deny ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

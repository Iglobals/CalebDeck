rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isRider() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'RIDER';
    }

    function isOrderOwner() {
      return isAuthenticated() &&
        'userId' in resource.data &&
        resource.data.userId != null &&
        resource.data.userId == request.auth.uid;
    }

    function isAssignedOrderRider() {
      return isRider() &&
        resource.data.assignedRiderId == request.auth.uid;
    }

    function riderOrderStatusAllowed() {
      return request.resource.data.status in ['ON_THE_WAY', 'DELIVERED'] &&
        (
          (resource.data.status == 'OUT_FOR_DELIVERY' && request.resource.data.status in ['ON_THE_WAY', 'DELIVERED']) ||
          (resource.data.status == 'ON_THE_WAY' && request.resource.data.status == 'DELIVERED')
        );
    }

    // ─── Menu Items ───
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Mart Items ───
    match /mart_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Fashion Inventory ───
    match /fashion_inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Fashion Categories ───
    match /fashion_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Combo Packs ───
    match /combo_packs/{comboId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Hostels ───
    match /hostels/{hostelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Orders ───
    // Server creates orders (Firebase Admin SDK bypasses rules).
    // Guests track via /api/utils/track-order with a high-entropy trackingToken.
    match /orders/{orderId} {
      allow get: if isAdmin() || isOrderOwner() || isAssignedOrderRider();
      allow list: if isAdmin() || isOrderOwner() || isAssignedOrderRider();

      allow create: if isAdmin();

      allow update: if isAdmin() ||
        (isAssignedOrderRider() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']) &&
          riderOrderStatusAllowed());

      allow delete: if isAdmin();
    }

    // ─── Mart Orders ───
    match /mart_orders/{orderId} {
      allow get: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isRider() && resource.data.riderId == request.auth.uid);
      allow list: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isRider() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isRider() &&
          resource.data.riderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in ['ON_THE_WAY', 'DELIVERED']);
      allow delete: if isAdmin();
    }

    // ─── Batches ───
    match /batches/{batchId} {
      allow read: if isAdmin() ||
        (isRider() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isRider() &&
          resource.data.riderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status']) &&
          request.resource.data.status == 'DELIVERED');
      allow delete: if isAdmin();
    }

    // ─── Riders ───
    // Public read: students see assigned rider name/phone on tracking page
    match /riders/{riderId} {
      allow read: if true;

      // Riders edit their own profile (status, bank details, FCM tokens) but can
      // never self-activate — activation is admin-only.
      allow update: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == riderId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive']));

      allow create: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == riderId &&
          request.resource.data.isActive != true);
      allow delete: if isAdmin();
    }

    // ─── Users (Auth profiles) ───
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (!('walletBalance' in request.resource.data) || request.resource.data.walletBalance == 0);
      allow update: if isAdmin() ||
        (isAuthenticated() && request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
            (!('role' in resource.data) && request.resource.data.role == 'STUDENT')
          ));

      // Admin reads all users (for FCM tokens, etc.)
      allow read: if isAdmin();

      allow delete: if isAdmin();
    }

    // ─── Notifications ───
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.userId == 'admin' && isAdmin())
      );

      // Users may create notifications addressed to themselves; only admins can
      // address anyone. (Riders create their own 'admin'-addressed read receipts
      // via the client when reporting — restricted to unread, non-admin senders.)
      allow create: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.userId == 'admin' && isAdmin())
      );

      allow delete: if isAdmin();
    }

    // ─── Rider Stats & Earnings ───
    match /riderStats/{riderId}/weekly/{weekId} {
      allow read: if isAdmin() || (isRider() && request.auth.uid == riderId);
      allow write: if isAdmin() || (isRider() && request.auth.uid == riderId);
    }

    match /riderEarnings/{riderId}/daily/{date} {
      allow read: if isAdmin() || (isRider() && request.auth.uid == riderId);
      allow write: if isAdmin() || (isRider() && request.auth.uid == riderId);
    }

    match /bonus_claims/{claimId} {
      allow read: if isAdmin() || (isRider() && resource.data.riderId == request.auth.uid);
      allow create: if isRider() && request.resource.data.riderId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Rider Payouts ───
    match /rider_payouts/{payoutId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow create: if isAdmin();  // Payout records are admin-issued only
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── CalebNet ───
    match /calebnet_catalog/{planId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if isAdmin();
    }

    match /calebnet_provider_plans/{planId} {
      allow read, write: if isAdmin();
    }

    match /calebnet_orders/{orderId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if false; // Only backend (Admin SDK) creates
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /calebnet_analytics_daily/{dateId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend (Admin SDK) writes
    }

    match /calebnet_provider_status/{statusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ─── Food Batch Days (Order Windows) ───
    match /food_batch_days/{dayId} {
      allow read: if true;           // Students see order count / batch status
      allow write: if isAdmin();     // Admin can update status manually
      // Note: Server (Admin SDK) handles atomic increments and bypasses rules
    }

    // ─── Settings ───
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── System monitoring (server-written, admin-read) ───
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system_log_groups/{groupId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system_incidents/{incidentId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolutionNotes', 'resolvedAt', 'acknowledgedAt', 'acknowledgedBy', 'updatedAt']);
    }

    match /system_health/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Launch promo claims — server writes, admin reads
    match /first_order_discount_claims/{claimId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Reviews ───
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.orderId is string &&
        request.resource.data.orderId.size() > 0;
      allow update, delete: if isAdmin();
    }

    // ─── CalebDeck Business ───
    match /business_vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /business_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /business_referrals/{refId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /vendor_auth_attempts/{attemptId} {
      allow read, write: if false; // Server-only access via Admin SDK
    }

    match /vendor_subscription_payments/{paymentId} {
      allow read: if isAdmin();       // Admin can view payment audit trail
      allow write: if false;          // Server-only (Admin SDK) creates these
    }

    // ─── Default deny ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

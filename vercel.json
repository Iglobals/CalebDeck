{
    "crons": [
        {
            "path": "/api/utils/health-check",
            "schedule": "0 7 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/fashion-delivery-request",
            "destination": "/api/fashion-delivery?route=request"
        },
        {
            "source": "/api/verify-calebnet-payment",
            "destination": "/api/calebnet?path=verify-payment"
        },
        {
            "source": "/api/calebnet/(.*)",
            "destination": "/api/calebnet?path=$1"
        },
        {
            "source": "/((?!api/|assets/).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/firebase-messaging-sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}

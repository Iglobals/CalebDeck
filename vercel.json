{
    "rewrites": [
        {
            "source": "/api/fashion-delivery-request",
            "destination": "/api/fashion-delivery?route=request"
        },
        {
            "source": "/api/verify-calebnet-payment",
            "destination": "/api/calebnet?path=verify-payment"
        },
        {
            "source": "/api/calebnet/(.*)",
            "destination": "/api/calebnet?path=$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)\\.(css|js|woff2|woff|ttf|svg|jpg|jpeg|png|webp|gif|json|ico)$",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        }
    ]
}
